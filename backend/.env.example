# Strava OAuth Configuration
STRAVA_CLIENT_ID=1942298
STRAVA_CLIENT_SECRET=your_secret_here
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/auth/strava/callback

# Frontend URL for OAuth callback redirection
FRONTEND_URL=http://localhost:8501

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/running_analytics
# Or for local SQLite:
# DATABASE_URL=sqlite:///./test.db

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
